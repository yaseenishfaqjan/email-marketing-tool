# ---------------------------------------------------------------- database --
DATABASE_URL=postgres://mailer:mailer@localhost:5432/mailer

# --------------------------------------------------------------------- app --
PORT=8080
NODE_ENV=development

# Signs unsubscribe, open and click tokens. 32+ random bytes, hex.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every unsubscribe link already in an inbox, so
# treat it as permanent.
TOKEN_SECRET=

# Logs into the admin API. Long and random; it is a bearer credential.
ADMIN_TOKEN=

# Public base URL of this service, used to build tracking links when a brand
# has no tracking domain of its own yet.
PUBLIC_URL=http://localhost:8080

# --------------------------------------------------------------------- ses --
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How many SES calls per second the workers may make in total. Set this to
# ~80% of the account's real send rate: SES throttles hard at the limit, and a
# Throttling error mid-broadcast costs far more than sending a little slower.
SES_MAX_SEND_RATE=10

# Leave true until SES production access is granted. In the sandbox SES only
# accepts verified recipients, so a broadcast would fail per-message and mark
# hundreds of rows failed.
SES_SANDBOX=true

# ----------------------------------------------------------------- workers --
SEND_BATCH_SIZE=100
WORKER_POLL_MS=2000
